# 依赖与构建产物
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本地备份（导出的 json 不要提交，里面可能有私人图片）
lifeboard-backup-*.json
*.local.json

# 局域网同步的数据仓库（里面是你的任务和图片）
sync-data/

# 本机自签证书和私钥（每台电脑自己生成，绝不能提交）
certs/

# Python（图标生成脚本的缓存）
__pycache__/
*.pyc
